# Cloudflare Pages — cache rules

# Long-lived immutable assets (hashed filenames if you ever add them)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Generated HTML pages — revalidate on each deploy
/id/*
  Cache-Control: public, max-age=0, must-revalidate
/en/*
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/404.html
  Cache-Control: public, max-age=0, must-revalidate

# Search indexes — revalidate on each deploy
/id/search-index.json
  Cache-Control: public, max-age=0, must-revalidate
/en/search-index.json
  Cache-Control: public, max-age=0, must-revalidate

# CSS — revalidate (no content hashing yet in v1)
/styles.css
  Cache-Control: public, max-age=0, must-revalidate

# Security headers
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer-when-downgrade

# HSTS — force HTTPS for one year
/*
  Strict-Transport-Security: max-age=31536000
